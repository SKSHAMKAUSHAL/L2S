# =============================================================================
# L2S — Long-to-Short Viral Video Engine (.env.example)
# =============================================================================
# Copy this template to .env and configure for your local environment:
#   cp .env.example .env

# ─── Server Configuration ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Local AI Inference (Ollama) — 100% Free & Local ────────────────────────
# Ollama daemon endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Default Local Model: llama3.2:3b
# Optimized for NVIDIA GeForce RTX 2050 (4GB VRAM):
# Fits 100% inside GPU VRAM (~2.2GB), achieves 75+ tok/s with zero RAM offloading.
MODEL=llama3.2:3b

# ─── Cloud AI Provider (Groq LPUs) ──────────────────────────────────────────
# Groq Cloud API Key (Enables Llama 3.3 70B & Whisper Large v3 Turbo)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ─── Video & Pipeline Settings ───────────────────────────────────────────────
# Number of clips to generate (0 = dynamic auto-selection based on video duration)
CLIPS=0

# ─── YouTube Shorts Publishing (OAuth 2.0) ──────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Set Authorized Redirect URI: http://localhost:3000/api/auth/callback/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ─── Instagram Reels Publishing (Meta Graph API) ─────────────────────────────
# 1. Go to https://developers.facebook.com/
# 2. Create an App → Add "Instagram Graph API" product
# 3. Set Authorized Redirect URI: http://localhost:3000/api/auth/callback/instagram
# Requires an Instagram Creator or Business account linked to a Facebook Page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── Cloud Storage (Optional) ────────────────────────────────────────────────
# Firebase Storage bucket name for temporary public hosting if needed
FIREBASE_BUCKET=
