# =============================================================================
# L2S — Long-to-Short Viral Video Engine (.env.example)
# =============================================================================
# Copy this template to .env and configure for your local environment:
#   cp .env.example .env

# ─── 1. Server & Security Configuration ──────────────────────────────────────
# Express server listening port
PORT=3000

# Application environment ("development" or "production")
NODE_ENV=development

# Canonical public base URL (used for OAuth redirects, webhooks and links)
BASE_URL=http://localhost:3000

# Allowed CORS and WebSocket origin (set to exact origin or * for wildcard)
APP_ORIGIN=http://localhost:3000

# Express trust proxy setting (for deployment behind Caddy, Nginx or Cloudflare)
TRUST_PROXY=1

# AES-256-GCM Token Encryption Key (32 random bytes, base64 encoded)
# Used to encrypt OAuth tokens at rest in SQLite. Refuses to start in production if invalid.
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Active Key ID for token encryption (supports key rotation)
CURRENT_KID=k1

# Optional JSON map for multi-key rotation: '{"k1":"<base64>","k2":"<base64>"}'
# TOKEN_ENC_KEYS=

# Structured logger level: "debug", "info", "warn", "error" (uses Pino with redaction)
LOG_LEVEL=info

# ─── 2. Database & Background Queue ──────────────────────────────────────────
# SQLite database file path (defaults to data/l2s.sqlite)
DB_PATH=data/l2s.sqlite

# Redis connection URL for BullMQ production job queue (e.g. redis://localhost:6379)
# Leave unset to use the built-in in-memory queue for development
# REDIS_URL=redis://localhost:6379

# Maximum concurrent processing jobs handled by background worker (default: 1)
WORKER_CONCURRENCY=1

# ─── 3. Cloud AI Providers (Groq LPUs) ───────────────────────────────────────
# Active LLM provider: "groq" (fast Cloud LPUs) or "ollama" (local)
LLM_PROVIDER=groq

# Groq Cloud API Key (Get a free key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_placeholder_groq_api_key_for_testing

# Groq LLM model for virality scoring, hook extraction, titles and hashtags
GROQ_MODEL=llama-3.3-70b-versatile

# Groq Whisper model for cloud Speech-to-Text transcription
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Max context tokens for the clip intelligence engine
CLIP_ENGINE_MAX_TOKENS=4096

# ─── 4. Local AI Inference (Ollama & Local Whisper) ──────────────────────────
# Ollama daemon endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Default local Ollama model (optimized for 4GB VRAM like NVIDIA RTX 2050)
MODEL=llama3.2:3b

# Local Whisper model size (tiny, base, small, medium)
LOCAL_WHISPER_MODEL=base

# Allow silent local fallback if Groq API fails or rate-limits (default: false)
STT_ALLOW_LOCAL_FALLBACK=false

# ─── 5. Video Processing & Downloader Pipeline ──────────────────────────────
# Target clips count (0 = dynamic auto-selection based on video duration)
CLIPS=0

# Local cache directory path for downloaded videos and transcripts
CACHE_DIR=.cache

# Maximum allowed video download size in bytes (500 MB = 524288000)
MAX_DOWNLOAD_BYTES=524288000

# Maximum video duration filter for downloads in seconds (1800s = 30 minutes)
MAX_SECONDS=1800

# Enable AI-powered Hinglish phonetic cleanup & glossary alignment
CLEANUP_ENABLED=true

# Concurrent worker limit for face-tracking 9:16 reframe processing
REFRAME_CONCURRENCY=2

# ─── 6. YouTube Shorts Publishing (OAuth 2.0 & Quotas) ──────────────────────
# Google Cloud Console OAuth 2.0 Client ID (Web Application)
YOUTUBE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com

# Google Cloud Console OAuth 2.0 Client Secret
YOUTUBE_CLIENT_SECRET=placeholder-client-secret

# Default privacy status for uploaded videos: "private" or "public"
# Note: Unverified Google apps are automatically forced to private by YouTube
YT_DEFAULT_PRIVACY=private

# App-wide daily YouTube Data API quota units limit (default: 10,000 units/day)
# Each video upload costs 1,600 units (~6 uploads/day default project quota)
YT_APP_DAILY_QUOTA=10000

# Optional custom Google endpoints (leave commented to use official Google URLs)
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
# GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
# GOOGLE_UPLOAD_URL=https://www.googleapis.com/upload/youtube/v3/videos?uploadType=resumable&part=snippet,status

# ─── 7. Instagram Reels Publishing (Meta Graph API) ─────────────────────────
# Feature flag to enable/disable Instagram publishing UI and routes
FEATURE_INSTAGRAM=false

# Meta App ID (from developers.facebook.com)
INSTAGRAM_APP_ID=

# Meta App Secret
INSTAGRAM_APP_SECRET=

# ─── 8. Cloud Storage (Optional) ─────────────────────────────────────────────
# Firebase Storage bucket name for temporary public hosting if needed
FIREBASE_BUCKET=
