# =============================================================================
# L2S — Long-to-Short Viral Video Engine (.env.example)
# =============================================================================
# Copy this template to .env and configure for your local environment:
#   cp .env.example .env

# ─── Server Configuration ───────────────────────────────────────────────────
# Port for the Express server to listen on
PORT=3000
# Canonical base URL used for OAuth redirects and webhooks
BASE_URL=http://localhost:3000
# Application environment (development or production)
NODE_ENV=development
# Secret key used for signing session cookies and CSRF tokens (min 32 chars)
SESSION_SECRET=placeholder-session-secret-change-in-production-min-32-chars
# Base64 32-byte key for AES-256-GCM token encryption
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ─── AI Providers (Groq & Ollama) ──────────────────────────────────────────
# Active LLM provider: "groq" (cloud LPU) or "ollama" (local)
LLM_PROVIDER=groq
# Groq Cloud API Key (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_placeholder_groq_api_key_for_testing
# Groq LLM model for ranking, hooks, titles and hashtags
GROQ_MODEL=llama-3.3-70b-versatile
# Groq Whisper model for cloud Speech-to-Text
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ─── Local AI Inference (Ollama) — Optional Offline Fallback ────────────────
# Ollama daemon endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
# Local LLM model identifier in Ollama
MODEL=llama3.2:3b
# Local Whisper model size (tiny, base, small, medium)
LOCAL_WHISPER_MODEL=base
# Allow silent fallback to local Whisper if Groq fails (default: false)
STT_ALLOW_LOCAL_FALLBACK=false

# ─── Video & Pipeline Settings ───────────────────────────────────────────────
# Default target clips count (0 = dynamic auto-selection based on duration)
CLIPS=0
# Local cache directory path for downloads and transcripts
CACHE_DIR=.cache
# Maximum allowed download file size in bytes (e.g. 500MB = 524288000)
MAX_DOWNLOAD_BYTES=524288000
# Cleanup enabled for Hinglish/Glossary processing
CLEANUP_ENABLED=true

# ─── YouTube Shorts Publishing (OAuth 2.0) ──────────────────────────────────
# Google Cloud Console OAuth 2.0 Client ID
YOUTUBE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
# Google Cloud Console OAuth 2.0 Client Secret
YOUTUBE_CLIENT_SECRET=placeholder-client-secret
# Default privacy status for uploaded videos ("private" or "public")
YT_DEFAULT_PRIVACY=private

# ─── Instagram Reels Publishing (Meta Graph API) ─────────────────────────────
# Feature flag to enable/disable Instagram publishing
FEATURE_INSTAGRAM=false
# Meta App ID
INSTAGRAM_APP_ID=placeholder-instagram-app-id
# Meta App Secret
INSTAGRAM_APP_SECRET=placeholder-instagram-app-secret

# ─── Cloud Storage (Optional) ────────────────────────────────────────────────
# Firebase Storage bucket name for temporary public hosting if needed
FIREBASE_BUCKET=
